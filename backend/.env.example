# PUBLIC
PORT=8787
NODE_ENV=development
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
UNICHAIN_RPC_URL=https://sepolia.unichain.org
INDEXER_ENABLED=true
INDEXER_START_BLOCK_LASNA=
INDEXER_START_BLOCK_UNICHAIN=
CORS_ORIGINS=http://localhost:5173

# SECRET: service-role key. Server-side only. Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set the bot credentials and frontend origin together.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_APP_ORIGIN=http://localhost:5173
# Use polling for local development with a bot that has no registered webhook.
# TELEGRAM_UPDATES=polling
# The V2 Lasna factory is trusted automatically. List additional trusted factories here.
# TELEGRAM_AGENT_FACTORIES=
# WORKFLOW_DIRECTORY_ADDRESS=
# WORKFLOW_VAULT_FACTORY_ADDRESS=
# WORKFLOW_START_BLOCK_LASNA=
# WORKFLOW_START_BLOCK_UNICHAIN=

# WORKFLOW_V2_DEPLOYMENT is a JSON object with "lasna" and "unichain" entries.
# Each entry contains the confirmed V2 "factory" address and integer "startBlock".
# WORKFLOW_V2_DEPLOYMENT=
