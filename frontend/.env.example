# PUBLIC ONLY. Anything VITE_* is compiled into the browser bundle.
VITE_API_BASE_URL=http://localhost:8787
VITE_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
VITE_UNICHAIN_RPC_URL=https://unichain-sepolia-rpc.publicnode.com
# Optional public HTTPS RPC with transaction support, offered when a wallet adds Unichain Sepolia.
VITE_UNICHAIN_WALLET_RPC_URL=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_AGENT_FACTORY_ADDRESS=
VITE_VAULT_FACTORY_ADDRESS=
VITE_PREVIOUS_VAULT_FACTORY_ADDRESS=
# Fallback proof reader that talks to Lasna directly if the backend is down (T144).
VITE_ENABLE_CHAIN_ONLY_PROOF=false
VITE_ENABLE_MIRROR=false
