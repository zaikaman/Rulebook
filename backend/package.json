{
  "name": "@rulebook/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rulebook Workflow V2 indexer, API, and Telegram notification worker. Holds no key that can move principal.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --include ../deployments/workflows-v2.json --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile ../node_modules/.cache/tsc/backend-typecheck.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "telegram:webhook": "node --env-file-if-exists=.env --import tsx scripts/telegram-webhook.ts",
    "notify:done": "node --env-file-if-exists=.env --import tsx scripts/notify-agent-done.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@rulebook/shared": "0.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^5.1.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
