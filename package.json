{
  "name": "rulebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "No-code builder for personal on-chain automations: the user keeps the money, the operator pays the gas.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "contracts",
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build -w packages/shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run generate -w packages/shared",
    "check": "node scripts/check.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings 0"
    ],
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
