[TEMPLATE]
# PUBLIC ONLY. Anything VITE_* is compiled into the browser bundle.
VITE_API_BASE_URL=http://localhost:8787
VITE_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
VITE_UNICHAIN_RPC_URL=https://unichain-sepolia-rpc.publicnode.com
# Optional public HTTPS RPC with transaction support, offered when a wallet adds Unichain Sepolia.
VITE_UNICHAIN_WALLET_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional public HTTPS RPC with transaction support, offered when a wallet adds Base Sepolia.
VITE_BASE_SEPOLIA_WALLET_RPC_URL=
VITE_WALLETCONNECT_PROJECT_ID=
# Workflow V2 factories. JSON object with "lasna", "unichain", and optional "base" entries, each holding
# the confirmed factory address under "factory" and its indexer start under "startBlock".
# VITE_WORKFLOW_V2_DEPLOYMENT={"lasna":{"factory":"0x...","startBlock":0},"unichain":{"factory":"0x...","startBlock":0},"base":{"factory":"0x...","startBlock":0}}
# Optional Mainnet Workflow V2 factories ("reactive", "unichain", and optional "base").
# VITE_WORKFLOW_V2_MAINNET_DEPLOYMENT={"reactive":{"factory":"0x...","startBlock":0},"unichain":{"factory":"0x...","startBlock":0},"base":{"factory":"0x...","startBlock":0}}
# Allow new workflow activations. Leave false to keep the app read-only.
VITE_WORKFLOW_V2_ACTIVATION=false
