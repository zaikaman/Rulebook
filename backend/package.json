{
  "name": "@rulebook/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only indexer and read API. Holds no key that can move principal.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx scripts/migrate.ts",
    "reindex": "tsx src/indexer/backfill.ts --reindex",
    "verify:reconcile": "tsx scripts/reconcile.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@rulebook/shared": "0.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^5.1.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
