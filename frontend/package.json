    "@hugeicons/react": "^1.1.10",
    "@rulebook/shared": "0.1.0",
    "@tanstack/react-query": "^5.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "viem": "^2.21.0",
